# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Required: Your Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Required: Your Discord Application ID (same as bot token application)
DISCORD_APPLICATION_ID=your_application_id_here

# Optional: Guild ID for faster command sync during development (remove for global commands)
# DISCORD_GUILD_ID=your_guild_id_here

# Optional: Command prefix for text-based commands (default: !)
COMMAND_PREFIX=!

# Optional: Bot status message
BOT_STATUS=Chatting with users | /help

# LLM API Configuration (for free tier LLM integration)
# Example: OpenRouter, Together.ai, Groq, etc.
LLM_API_URL=https://api.example.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=meta-llama/llama-3-8b-instruct
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
LLM_SYSTEM_PROMPT=You are a helpful, friendly, and engaging Discord chatbot. You respond naturally to users in a conversational manner. Keep responses concise but informative. You can use Discord markdown formatting when appropriate.

# Rate limiting (messages per minute per user)
RATE_LIMIT_PER_USER=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log